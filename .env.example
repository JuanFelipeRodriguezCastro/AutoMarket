# Conexión a MySQL/MariaDB (local o gestionado).
# - Docker Compose: la app usa el host "mysql" y el puerto 3306 (red interna).
# - Desde el host, el MySQL de docker-compose se publica en 127.0.0.1:3307.
# - TiDB Cloud / Aiven: añade tls=true al final del DSN.
DATABASE_DSN=automarket:automarket@tcp(127.0.0.1:3307)/automarket?parseTime=true&charset=utf8mb4

# Administrador inicial (solo se crea si no existe ninguno).
AUTOMARKET_ADMIN_USER=admin
AUTOMARKET_ADMIN_PASSWORD=cambia-esta-clave

# Render define PORT automáticamente; en local el valor por defecto es 8080.
PORT=8080

# HTTPS local opcional. En Render el TLS lo termina la plataforma.
# TLS_CERT_FILE=certs/cert.pem
# TLS_KEY_FILE=certs/key.pem
